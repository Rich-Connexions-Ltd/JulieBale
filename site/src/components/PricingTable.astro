---
interface Tier {
  title: string;
  subtitle?: string;
  price: string;
  period?: string;
  altPrice?: string;
  features: string[];
  cta: string;
  href: string;
  highlight?: boolean;
  highlightLabel?: string;
}

interface Props {
  heading?: string;
  subheading?: string;
  tiers: Tier[];
  bgColor?: string;
}

const {
  heading,
  subheading,
  tiers,
  bgColor = 'var(--color-white)',
} = Astro.props;
---

<section class="section pricing-table-section" style={`background-color: ${bgColor};`}>
  <div class="container">
    {heading && (
      <div class="pricing-table-header">
        <h2>{heading}</h2>
        {subheading && <p class="pricing-table-subheading">{subheading}</p>}
      </div>
    )}

    <div class:list={['pricing-table-grid', `pricing-table-grid--${tiers.length}`]}>
      {tiers.map(({ title, subtitle, price, period, altPrice, features, cta, href, highlight, highlightLabel = 'Most popular' }) => (
        <div class:list={['pricing-tier', { 'pricing-tier--highlight': highlight }]}>
          {highlight && (
            <div class="pricing-tier-badge">{highlightLabel}</div>
          )}
          <div class="pricing-tier-header">
            <h3 class="pricing-tier-title">{title}</h3>
            {subtitle && <p class="pricing-tier-subtitle">{subtitle}</p>}
            <div class="pricing-tier-price">
              <span class="price-amount">{price}</span>
              {period && <span class="price-period">{period}</span>}
            </div>
            {altPrice && <p class="price-alt">{altPrice}</p>}
          </div>
          <ul class="pricing-tier-features" role="list">
            {features.map(f => (
              <li>
                <i class="fas fa-check" aria-hidden="true"></i>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <a
            href={href}
            class:list={['btn', 'btn--md', 'btn--full', highlight ? 'btn--primary' : 'btn--outline']}
            rel="noopener"
          >
            {cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pricing-table-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .pricing-table-subheading {
    font-size: var(--text-lg);
    color: var(--color-grey);
    max-width: 560px;
    margin-inline: auto;
    margin-top: var(--space-4);
    margin-bottom: 0;
    line-height: var(--leading-loose);
  }

  .pricing-table-grid {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .pricing-table-grid--2 { grid-template-columns: repeat(2, 1fr); }
  .pricing-table-grid--3 { grid-template-columns: repeat(3, 1fr); }
  .pricing-table-grid--4 { grid-template-columns: repeat(4, 1fr); }

  .pricing-tier {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-sm);
  }

  .pricing-tier--highlight {
    border-color: var(--color-gold);
    border-width: 2px;
    box-shadow: var(--shadow-md);
  }

  .pricing-tier-badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--color-gold);
    color: var(--color-white);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .pricing-tier-header {
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .pricing-tier-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .pricing-tier-subtitle {
    font-size: var(--text-sm);
    color: var(--color-teal-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-3);
  }

  .pricing-tier-price {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .price-amount {
    font-family: var(--font-editorial);
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-charcoal);
    line-height: 1;
  }

  .price-period {
    font-size: var(--text-sm);
    color: var(--color-grey);
  }

  .price-alt {
    font-size: var(--text-sm);
    color: var(--color-teal-muted);
    margin-top: var(--space-2);
    margin-bottom: 0;
  }

  .pricing-tier-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }

  .pricing-tier-features li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-charcoal);
    line-height: var(--leading-normal);
  }

  .pricing-tier-features .fa-check {
    color: var(--color-teal);
    flex-shrink: 0;
    margin-top: 3px;
  }

  @media (max-width: 900px) {
    .pricing-table-grid--3,
    .pricing-table-grid--4 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .pricing-table-grid--2,
    .pricing-table-grid--3,
    .pricing-table-grid--4 { grid-template-columns: 1fr; }
  }
</style>
