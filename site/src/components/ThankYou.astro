---
interface Props {
  heading?: string;
  subheading?: string;
  body?: string;
  cta?: string;
  ctaHref?: string;
  ctaVariant?: string;
  icon?: string;
}

const {
  heading = 'Thank You!',
  subheading,
  body,
  cta = 'Back to Home',
  ctaHref = '/',
  ctaVariant = 'btn--primary',
  icon = 'fas fa-heart',
} = Astro.props;

const hasSlot = Astro.slots.has('default');
---

<section class="section thankyou-section">
  <div class="container thankyou-inner">
    <div class="thankyou-icon" aria-hidden="true">
      <i class={icon}></i>
    </div>
    <h1 class="thankyou-heading">{heading}</h1>
    {subheading && <p class="thankyou-subheading">{subheading}</p>}
    {body && <p class="thankyou-body">{body}</p>}
    {hasSlot && <div class="thankyou-slot"><slot /></div>}
    <a href={ctaHref} class={`btn btn--lg ${ctaVariant}`}>{cta}</a>
  </div>
</section>

<style>
  .thankyou-section {
    background-color: #f8f8f6;
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .thankyou-inner {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }

  .thankyou-icon {
    font-size: 3rem;
    color: var(--color-gold);
    margin-bottom: var(--space-6);
  }

  .thankyou-heading {
    margin-bottom: var(--space-4);
  }

  .thankyou-subheading {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--color-charcoal);
    line-height: var(--leading-loose);
    margin-bottom: var(--space-4);
  }

  .thankyou-body {
    font-size: var(--text-base);
    color: var(--color-grey);
    line-height: var(--leading-loose);
    margin-bottom: var(--space-8);
  }

  .thankyou-slot {
    margin-bottom: var(--space-8);
  }
</style>
