---
interface Props {
  title: string;
  slug: string;
  date: string;
  excerpt?: string;
  image?: string;
  imageAlt?: string;
  tags?: string[];
}

const {
  title,
  slug,
  date,
  excerpt,
  image,
  imageAlt = '',
  tags = [],
} = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<article class="blog-card">
  {image && (
    <a href={`/blog/${slug}`} class="blog-card-image-link" tabindex="-1" aria-hidden="true">
      <img
        src={image}
        alt={imageAlt}
        width="400"
        height="260"
        loading="lazy"
        decoding="async"
        class="blog-card-image"
      />
    </a>
  )}
  <div class="blog-card-body">
    {tags.length > 0 && (
      <ul class="blog-card-tags" aria-label="Tags">
        {tags.map(tag => (
          <li>
            <a href={`/blog?tag=${tag}`} class="tag-badge">{tag}</a>
          </li>
        ))}
      </ul>
    )}
    <h3 class="blog-card-title">
      <a href={`/blog/${slug}`} class="blog-card-title-link">{title}</a>
    </h3>
    {excerpt && <p class="blog-card-excerpt">{excerpt}</p>}
    <time class="blog-card-date" datetime={date}>{formattedDate}</time>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-white);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-normal), transform var(--transition-normal);
  }

  .blog-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .blog-card-image-link {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }

  .blog-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .blog-card:hover .blog-card-image {
    transform: scale(1.04);
  }

  .blog-card-body {
    padding: var(--space-5);
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .blog-card-tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .tag-badge {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-teal-muted);
    background-color: rgba(102, 188, 188, 0.1);
    border: 1px solid rgba(102, 188, 188, 0.3);
    padding: 2px var(--space-2);
    border-radius: var(--radius-full);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .tag-badge:hover {
    background-color: var(--color-teal);
    color: var(--color-white);
    border-color: var(--color-teal);
  }

  .blog-card-title {
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    margin-bottom: 0;
  }

  .blog-card-title-link {
    color: var(--color-charcoal);
    transition: color var(--transition-fast);
  }

  .blog-card-title-link:hover {
    color: var(--color-gold);
  }

  .blog-card-excerpt {
    font-size: var(--text-sm);
    color: var(--color-grey);
    line-height: var(--leading-normal);
    margin-bottom: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card-date {
    font-size: var(--text-xs);
    color: var(--color-teal-muted);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-top: auto;
  }
</style>
