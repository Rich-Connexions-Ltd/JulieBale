---
interface Props {
  title: string;
  date: string;
  venue?: string;
  location?: string;
  description?: string;
  cta?: string;
  href?: string;
  image?: string;
  imageAlt?: string;
  soldOut?: boolean;
  tags?: string[];
}

const {
  title,
  date,
  venue,
  location,
  description,
  cta = 'Book Now',
  href,
  image,
  imageAlt = '',
  soldOut = false,
  tags = [],
} = Astro.props;

const dateObj = new Date(date);
const day = dateObj.toLocaleDateString('en-GB', { day: 'numeric' });
const month = dateObj.toLocaleDateString('en-GB', { month: 'short' }).toUpperCase();
const year = dateObj.toLocaleDateString('en-GB', { year: 'numeric' });
const fullDate = dateObj.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
---

<article class:list={['event-card', { 'event-card--sold-out': soldOut }]}>
  {image && (
    <div class="event-card-image">
      <img src={image} alt={imageAlt} loading="lazy" />
      {soldOut && <div class="event-card-sold-out-badge">Sold Out</div>}
    </div>
  )}

  <div class="event-card-body">
    <div class="event-card-date-block" aria-label={fullDate}>
      <span class="event-date-day">{day}</span>
      <span class="event-date-month">{month}</span>
      <span class="event-date-year">{year}</span>
    </div>

    <div class="event-card-info">
      {tags.length > 0 && (
        <div class="event-card-tags">
          {tags.map(tag => <span class="event-tag">{tag}</span>)}
        </div>
      )}
      <h3 class="event-card-title">{title}</h3>
      {venue && <p class="event-card-venue"><i class="fas fa-map-marker-alt" aria-hidden="true"></i> {venue}{location ? `, ${location}` : ''}</p>}
      {description && <p class="event-card-description">{description}</p>}
      {href && !soldOut && (
        <a href={href} class="btn btn--sm btn--primary" rel="noopener">{cta}</a>
      )}
      {soldOut && (
        <span class="btn btn--sm btn--outline" aria-disabled="true">Sold Out</span>
      )}
    </div>
  </div>
</article>

<style>
  .event-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-normal);
  }

  .event-card:hover { box-shadow: var(--shadow-md); }

  .event-card--sold-out { opacity: 0.7; }

  .event-card-image {
    position: relative;
    aspect-ratio: 16 / 7;
    overflow: hidden;
  }

  .event-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .event-card-sold-out-badge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    background-color: var(--color-charcoal);
    color: var(--color-white);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
  }

  .event-card-body {
    display: flex;
    gap: var(--space-5);
    padding: var(--space-6);
    align-items: flex-start;
  }

  .event-card-date-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: var(--color-gold);
    color: var(--color-white);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    min-width: 60px;
    flex-shrink: 0;
    text-align: center;
  }

  .event-date-day {
    font-family: var(--font-editorial);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    line-height: 1;
  }

  .event-date-month {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.06em;
    margin-top: 2px;
  }

  .event-date-year {
    font-size: var(--text-xs);
    opacity: 0.8;
    margin-top: 1px;
  }

  .event-card-info {
    flex: 1;
    min-width: 0;
  }

  .event-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .event-tag {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-teal-muted);
    background-color: rgba(102, 188, 188, 0.12);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }

  .event-card-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }

  .event-card-venue {
    font-size: var(--text-sm);
    color: var(--color-teal-muted);
    margin-bottom: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .event-card-description {
    font-size: var(--text-sm);
    color: var(--color-grey);
    line-height: var(--leading-loose);
    margin-bottom: var(--space-4);
  }
</style>
