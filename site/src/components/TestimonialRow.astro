---
import Testimonial from './Testimonial.astro';

interface TestimonialItem {
  quote: string;
  name: string;
  role?: string;
  image?: string;
  stars?: boolean;
}

interface Props {
  heading?: string;
  subheading?: string;
  items: TestimonialItem[];
  bgColor?: string;
  columns?: 1 | 2 | 3;
}

const {
  heading,
  subheading,
  items,
  bgColor = '#f8f8f6',
  columns = 3,
} = Astro.props;
---

<section class="testimonial-row section" style={`background-color: ${bgColor};`}>
  <div class="container">
    {(heading || subheading) && (
      <div class="testimonial-row-header">
        {heading && <h2>{heading}</h2>}
        {subheading && <p class="testimonial-row-sub">{subheading}</p>}
      </div>
    )}
    <ul
      class:list={['testimonial-list', `testimonial-list--cols-${columns}`]}
      role="list"
    >
      {items.map(item => (
        <li>
          <Testimonial {...item} />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .testimonial-row-header {
    text-align: center;
    max-width: 600px;
    margin-inline: auto;
    margin-bottom: var(--space-10);
  }

  .testimonial-row-sub {
    font-size: var(--text-lg);
    color: var(--color-grey);
    margin-top: var(--space-4);
    margin-bottom: 0;
  }

  .testimonial-list {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .testimonial-list--cols-1 { grid-template-columns: 1fr; max-width: 680px; margin-inline: auto; }
  .testimonial-list--cols-2 { grid-template-columns: repeat(2, 1fr); }
  .testimonial-list--cols-3 { grid-template-columns: repeat(3, 1fr); }

  @media (max-width: 900px) {
    .testimonial-list--cols-3 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 580px) {
    .testimonial-list--cols-2,
    .testimonial-list--cols-3 { grid-template-columns: 1fr; }
  }
</style>
