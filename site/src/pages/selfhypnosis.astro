---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TextImage from '../components/TextImage.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import CTABanner from '../components/CTABanner.astro';
import FormEmbed from '../components/FormEmbed.astro';
---

<BaseLayout
  title="Free Self-Hypnosis Guide for Singers | Julie Bale"
  description="Download Julie Bale's free self-hypnosis guide and learn how to use your mind to transform your performance confidence, release vocal tension, and step into your power."
>
  <Hero
    height="large"
    bgColor="var(--color-charcoal)"
    heading="Discover the Power of Self-Hypnosis"
    subheading="A free guide to using your mind to transform your performance — from the inside out."
    textColor="light"
    eyebrow="Free Resource"
    ctas={[
      { label: 'Get the Free Guide', href: '#optin', variant: 'btn--primary' },
    ]}
  />

  <!-- What you get -->
  <TextImage
    heading="Your Mind is Your Most Powerful Instrument"
    eyebrow="The Self-Hypnosis Guide"
    image="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159675705/settings_images/cf7f4c5-f02-0da2-5ad8-8cb220724e61_38b5d9d9-f7a2-40de-894e-e5b68af34a47.jpeg"
    imageAlt="Julie Bale — voice specialist and hypnotherapist"
    reverse={false}
    accentLine={true}
  >
    <p>
      As a qualified clinical hypnotherapist and vocal specialist, I know something most
      singing teachers don't: the biggest block to a powerful voice isn't technical — it's mental.
    </p>
    <p>
      Self-hypnosis is a tool I use with all my clients to help them release tension, silence
      the inner critic, and access a state of calm, focused confidence before they perform.
      And now I'm giving you the method — for free.
    </p>
    <p>
      In this guide you'll learn a simple, effective self-hypnosis practice you can use
      before any performance, audition, or important vocal moment.
    </p>
  </TextImage>

  <!-- Features -->
  <FeatureGrid
    heading="What's in the Guide"
    columns={3}
    bgColor="#f8f8f6"
    items={[
      {
        icon: 'fas fa-brain',
        heading: 'How Self-Hypnosis Works',
        body: 'Understand the science behind hypnotherapy and why it\'s so effective for performance anxiety and vocal confidence.',
      },
      {
        icon: 'fas fa-music',
        heading: 'A Step-by-Step Practice',
        body: 'A simple, repeatable self-hypnosis routine you can use in just 10 minutes before any performance.',
      },
      {
        icon: 'fas fa-shield-alt',
        heading: 'Releasing Performance Nerves',
        body: 'Specific techniques for calming the nervous system and silencing the inner critic when it matters most.',
      },
    ]}
  />

  <!-- Opt-in form -->
  <section id="optin" class="section section-optin" style="background-color: #f8f8f6;">
    <div class="container optin-inner">
      <div class="optin-copy">
        <p class="optin-eyebrow">Free Download</p>
        <h2>Get the Self-Hypnosis Guide</h2>
        <p>
          Enter your name and email and I'll send you the guide straight to your inbox.
          No spam, no hard sell — just the tools you need to transform your performance.
        </p>
      </div>
      <FormEmbed
        formId="2148842010"
        heading="Yes, Send Me the Guide!"
        submitLabel="Send It to Me"
        disclaimer="I respect your privacy. No spam, ever."
        bgColor="#f8f8f6"
      />
    </div>
  </section>

  <!-- CTA -->
  <CTABanner
    heading="Ready to Go Deeper?"
    body="The From First Note to Final Curtain programme integrates self-hypnosis into every stage of your vocal transformation."
    cta="Explore the Diva Programme"
    href="https://members.juliebale.com/resource_redirect/landing_pages/2150870945"
    variant="charcoal"
  />
</BaseLayout>

<style>
  .optin-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .optin-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .optin-copy h2 { margin-bottom: var(--space-4); }
  .optin-copy p { color: var(--color-grey); line-height: var(--leading-loose); margin-bottom: 0; }

  @media (max-width: 768px) {
    .optin-inner { grid-template-columns: 1fr; gap: var(--space-8); }
  }
</style>
