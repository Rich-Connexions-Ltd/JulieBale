---
/**
 * /homepage mirrors the root / page.
 * Both canonical to / so Google picks the root URL as authoritative.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialRow from '../components/TestimonialRow.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import CTABanner from '../components/CTABanner.astro';
import BlogCard from '../components/BlogCard.astro';

const KAJABI = 'https://members.juliebale.com';

const recentPosts = [
  {
    title: 'The DIVA Framework™: From Self-Doubt to Vocal Confidence & Presence',
    slug: 'divaframework',
    date: '2026-04-16',
    image: 'https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/sites/2147603041/images/7e7c703-1508-f10-252e-b02e5d335ec6_ChroniclesofHopeSeptember2025-209.JPG',
    tags: ['singer'],
  },
  {
    title: 'A Dream That Will Need All the Love You Can Give…',
    slug: 'nobodybetter',
    date: '2025-10-02',
    image: 'https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/blogs/2147505287/images/322c2f3-0ddb-dc2b-1e08-606130b057b_05026df1-de01-4234-8a77-0fd4e6794de9.jpg',
    tags: ['singer'],
  },
  {
    title: 'I Wish I Could Sing',
    slug: 'iwishicouldsing',
    date: '2025-06-15',
    image: 'https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/blogs/2147505287/images/4077f-ca47-73f0-60e2-5e2ea004cc4_13208476-f1b3-4f91-82ba-a52d58f41ecf.JPG',
    tags: ['singer'],
  },
];

const testimonials = [
  {
    quote: 'Julie has truly transformed every day of my future. Now, each morning feels like a song I can sing with confidence. She unlocked something deep within me and lifted my whole world to a new level.',
    name: 'Eve Stanway',
    stars: true,
  },
];
---

<BaseLayout
  title="Julie Bale Voice Specialist | Diva Energy®"
  description="I teach you how to sing and how to use your mind to transform your life using my unique, proven vocal transformation programme From First Note to Final Curtain."
  canonicalURL="https://www.juliebale.com/"
>
  <!-- Hero — cream panel style matching original -->
  <section class="home-hero">
    <div class="home-hero-panel">
      <p class="home-hero-pre">Hi, I'm Julie.</p>
      <h1 class="home-hero-heading">I help you <span class="typed-target"></span></h1>
      <a href="/workwithme" class="btn btn--md btn--primary">Work With Me</a>
    </div>
  </section>

  <!-- Intro panel -->
  <section class="intro-section">
    <div class="intro-image" aria-hidden="true"></div>
    <div class="intro-panel reveal-panel">
      <h2 class="intro-heading">Want to Know How Singing Can Improve Your Life?</h2>
      <div class="intro-body">
        <p>
          Many people carry a belief that singing isn't for them — that they're "tone deaf", or that
          they missed their chance. I'm here to tell you that's not true.
        </p>
        <p>
          Maybe someone once told you that you were "tone-deaf," or perhaps you've spent years
          wanting to sing but never knowing how to start. But what if that belief is the only thing
          holding you back?
        </p>
        <p>
          Over 35 years of teaching more than 1,000 singers, I've developed a unique approach
          that combines vocal technique, performance coaching, and the power of clinical
          hypnotherapy to help you find the voice — and the confidence — that's already inside you.
        </p>
      </div>
      <a href={`${KAJABI}/resource_redirect/landing_pages/2150870945`} class="btn btn--primary btn--md">
        From First Note to Final Curtain
      </a>
    </div>
  </section>

  <!-- A Bit About Me -->
  <section class="about-section section">
    <div class="container">
      <div class="about-grid">
        <div class="about-image">
          <img
            src="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159675705/settings_images/dce572-2f6-ac85-81b0-13b6d0124be_7dbb339d-e9da-4433-82be-c7e8b0667679.jpeg"
            alt="Julie Bale"
            width="520"
            height="620"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="about-text reveal-about">
          <h2 class="about-heading">A bit about me&hellip;</h2>
          <p>I'm Julie, I'm a singer, voice teacher, hypnotherapist, author and speaker.</p>
          <p>I've been singing forever and teaching singing in schools, tutoring top London choirs, working in private practice and conducting choirs and leading workshops in vocal technique, performance technique and performance mindset for over 35 years.</p>
          <p>I have a music degree, a PGCE, a diploma in singing from the Royal College of Music and I've trained with the incredible world renowned voice specialist Janice Chapman for over 25 years.</p>
          <p>I've always had a fascination for the psychology of performance and that led me to train as a Clinical Hypnotherapist and I use these skills to help my people go on stage, or be the face of their own business, free from performance anxiety, feeling free, fearless and fabulous.</p>
          <p>Taking someone and giving them the vocal skills and belief that they can sing is a personal mission of mine. My programme offers people the opportunity to find their singing voice and perform solo together with a group of beautiful souls — learning how to step into what I call Diva Energy® in both their singing and their lives.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- As Featured In -->
  <section class="featured-in section--sm">
    <div class="container">
      <p class="featured-in-label">As featured in</p>
      <div class="featured-in-logos" aria-label="Metro, Woman, Woman's Weekly, Classical Music Magazine, BBC">
        <img src="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159675705/settings_images/740aa88-b722-b30d-debc-ef438a583527_e4620c52-8ae7-4a6a-a332-03348e31f821.png" alt="Metro" loading="lazy" height="40" />
        <img src="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159675705/settings_images/447be8-2fa8-8dbd-067-7eb5667163c_147b650b-24a2-4c2e-8e5c-cbb06a758d56.png" alt="Woman" loading="lazy" height="40" />
        <img src="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159675705/settings_images/60fbe-a4e3-7d36-6c38-5c3cb3861_071129a3-0bde-4123-b04d-034fd0211624.png" alt="Woman's Weekly" loading="lazy" height="40" />
        <img src="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159675705/settings_images/6fcb6a1-ac77-cac5-cc46-f002a723ee_c05eef80-ef3e-4f45-9f83-562d1c5e34d8.png" alt="Classical Music Magazine" loading="lazy" height="40" />
        <img src="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159675705/settings_images/84b0036-bd86-3d08-e37f-512cba375eb_7235b9ec-f261-40d8-8549-ea4f062fabb2.png" alt="BBC" loading="lazy" height="40" />
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <TestimonialRow heading="What My Singers Say" items={testimonials} columns={1} />

  <!-- Why Work With Me? -->
  <section class="why-section section">
    <div class="container">
      <div class="why-inner reveal-why">
        <h2 class="why-heading">Why Work With Me?</h2>
        <div class="why-body">
          <p>Working with me is <strong>so much more than just singing lessons</strong> — it's a complete vocal and personal transformation.</p>
          <p>You'll join a vibrant community of like-minded, passionate people in business, where we <strong>celebrate each other's voices and successes</strong>.</p>
          <p>With over 35 years of experience in teaching, performing, and leading choirs — including as a resident singing teacher with top London choirs and a performer on major UK stages in opera, oratorio, and song — <strong>I bring a depth of expertise that's both rare and powerful.</strong></p>
          <p>My training with top coaches and professionals in the music industry, combined with my skills as a hypnotherapist, means I can help you overcome performance anxiety, imposter syndrome, and the fear of not being good enough.</p>
          <p><strong>I understand how to draw out your radiance, your presence, your charisma and help you feel confident, empowered, and fully expressed on any stage.</strong></p>
          <p>This is your chance to find your voice, transform your confidence, and be part of a supportive, growing tribe of people who are here to sing and shine together.</p>
        </div>
        <a href={`${KAJABI}/resource_redirect/landing_pages/2150870945`} class="btn btn--primary btn--md">
          From First Note to Final Curtain
        </a>
      </div>
    </div>
    <!-- Lesley Thomas testimonial -->
    <blockquote class="lesley-quote">
      <p class="lesley-quote-text">"Diva Energy to me means owning who I am, the space I am standing in, and how well I can fill that space."</p>
      <footer class="lesley-quote-credit">
        <span class="lesley-name">Lesley Thomas</span>
        <span class="lesley-company">The Money Confidence Academy</span>
      </footer>
    </blockquote>
  </section>

  <!-- Mailing List Signup -->
  <section class="mailing-section section">
    <div class="mailing-image" aria-hidden="true"></div>
    <div class="mailing-panel">
      <h3 class="mailing-heading">Not ready to join a course?</h3>
      <p class="mailing-body">Join my mailing list to discover more about how singing can improve your business and your life.</p>
      <form
        class="mailing-form"
        action="https://www.juliebale.com/forms/2148425370/form_submissions"
        method="post"
        target="_blank"
        rel="noopener"
      >
        <div class="mailing-fields">
          <input type="text" name="form_submission[name]" placeholder="Name" required class="mailing-input" />
          <input type="email" name="form_submission[email]" placeholder="Email" required class="mailing-input" />
          <button type="submit" class="btn btn--primary btn--md">Sign Up</button>
        </div>
        <p class="mailing-disclaimer">I respect your privacy. No spam. Ever.</p>
      </form>
    </div>
  </section>

  <!-- Work With Me feature -->
  <section class="work-section section">
    <div class="container">
      <h2 class="work-heading">Ready to Work With Me?</h2>
      <div class="work-divider" aria-hidden="true"></div>
      <div class="work-feature reveal-feature">
        <div class="work-feature-image">
          <img
            src="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159675705/settings_images/3af68cf-d2f3-246e-daff-6cba1c6833_5984f77c-2282-454c-9908-b44031587172.jpg"
            alt="Julie Bale — From First Note to Final Curtain"
            width="480"
            height="400"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="work-feature-text">
          <h3>From First Note to Final Curtain</h3>
          <p>
            The unique and proven vocal transformation course designed to give you the joy and
            skills of singing, Diva Energy® and finding your true voice. Over 6 or 12 months
            of 1:1 lessons, performance coaching, and mindset work — culminating in a gala concert.
          </p>
          <a href={`${KAJABI}/resource_redirect/landing_pages/2150870945`} class="btn btn--primary btn--md">
            Find Out More
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- All programmes grid -->
  <FeatureGrid
    heading="All the Ways You Can Work with Me"
    eyebrow="Programmes"
    columns={3}
    items={[
      {
        heading: 'BRAVO for Speakers',
        body: 'A transformational programme designed to unlock your most powerful, confident, and influential speaking voice. The BRAVO Framework® for speakers and leaders.',
        href: `${KAJABI}/resource_redirect/landing_pages/2151826137`,
        cta: 'Find Out More',
        ctaVariant: 'btn--secondary',
      },
      {
        heading: 'Diva Circle®',
        body: 'An intimate 6 or 12-month membership for singers who want ongoing coaching, community, and accountability to keep growing.',
        href: '/divacircle',
        cta: 'Find Out More',
        ctaVariant: 'btn--primary',
      },
      {
        heading: 'Diva Taster Experience',
        body: 'The 60-minute journey to vocal power and presence. Not ready to commit to the full programme? This is your perfect starting point.',
        href: `${KAJABI}/resource_redirect/landing_pages/2151639319`,
        cta: 'Start Here',
        ctaVariant: 'btn--outline',
      },
    ]}
    bgColor="#f8f8f6"
  />

  <!-- Recent blog posts -->
  <section class="section blog-preview">
    <div class="container">
      <div class="blog-preview-header">
        <h2>From the Blog</h2>
        <a href="/blog" class="btn btn--outline btn--sm">View all posts</a>
      </div>
      <div class="blog-preview-grid">
        {recentPosts.map(post => <BlogCard {...post} />)}
      </div>
    </div>
  </section>

  <CTABanner
    heading="Ready to Find Your Voice?"
    body="Join over 1,000 singers and speakers who have transformed their lives with Diva Energy®."
    cta="Work With Me"
    href="/workwithme"
    variant="charcoal"
  />
</BaseLayout>

<script>
  import Typed from 'https://cdn.jsdelivr.net/npm/typed.js@2.1.0/dist/typed.esm.js';
  const el = document.querySelector('.typed-target');
  if (el) {
    new Typed(el as HTMLElement, {
      strings: [
        'find your voice.',
        'step into your Diva Energy®.',
        'sing with confidence.',
        'transform your performance.',
        'believe in yourself.',
      ],
      typeSpeed: 60,
      backSpeed: 35,
      backDelay: 2400,
      loop: true,
    });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  document.querySelectorAll('.reveal-panel, .reveal-feature, .reveal-about, .reveal-why').forEach(el => observer.observe(el));
</script>

<style>
  /* ── Home hero — cream panel style ──────────────────────── */
  .home-hero {
    position: relative;
    min-height: 580px;
    background-image: url('https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159675705/settings_images/c434b7f-6a4-403c-f222-700e44cf675b_uuid_FA71A6C2-3566-4244-91A4-922AFA7B2EF5_library_1_type_1_mode_1_loc_true_cap_true.jpeg');
    background-size: cover;
    background-position: center top;
    display: flex;
    align-items: center;
    padding: var(--space-20) var(--space-8);
  }

  .home-hero-panel {
    background-color: rgba(245, 236, 210, 0.88);
    border-radius: var(--radius-md);
    padding: var(--space-10) var(--space-10);
    max-width: 480px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-left: clamp(var(--space-4), 6vw, 80px);
  }

  .home-hero-pre {
    font-family: var(--font-accent-1);
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    color: var(--color-charcoal);
    line-height: 1.1;
    margin: 0;
  }

  .home-hero-heading {
    font-size: clamp(var(--text-2xl), 3.5vw, var(--text-4xl));
    color: var(--color-charcoal);
    line-height: var(--leading-tight);
    margin: 0;
  }

  :global(.typed-target) { color: var(--color-gold); }
  :global(.typed-cursor) { color: var(--color-charcoal); }

  /* ── Intro section ───────────────────────────────────────── */
  .intro-section {
    display: grid;
    grid-template-columns: 5fr 6fr;
    min-height: 520px;
    background-color: #1e3f4a;
  }

  .intro-image {
    background-image: url('https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159675705/settings_images/cf7f4c5-f02-0da2-5ad8-8cb220724e61_38b5d9d9-f7a2-40de-894e-e5b68af34a47.jpeg');
    background-size: cover;
    background-position: center top;
    min-height: 420px;
  }

  .intro-panel {
    background-color: rgba(255, 255, 255, 0.93);
    padding: var(--space-12) var(--space-10);
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    transform: translateX(32px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .intro-panel.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  .intro-heading {
    font-size: clamp(var(--text-xl), 2.5vw, var(--text-3xl));
    color: var(--color-charcoal);
    margin-bottom: var(--space-5);
    line-height: var(--leading-tight);
  }

  .intro-body {
    font-size: var(--text-base);
    line-height: var(--leading-loose);
    color: var(--color-grey);
    margin-bottom: var(--space-6);
  }

  .intro-body p { margin-bottom: var(--space-4); }
  .intro-body p:last-child { margin-bottom: 0; }

  /* ── About Me ────────────────────────────────────────────── */
  .about-section { background-color: var(--color-white); }

  .about-grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: var(--space-12);
    align-items: center;
  }

  .about-image img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    object-fit: cover;
    display: block;
  }

  .about-text {
    opacity: 0;
    transform: translateX(28px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .about-text.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  .about-heading {
    font-size: clamp(var(--text-2xl), 3vw, var(--text-4xl));
    color: var(--color-charcoal);
    margin-bottom: var(--space-5);
    line-height: var(--leading-tight);
  }

  .about-text p {
    font-size: var(--text-base);
    line-height: var(--leading-loose);
    color: var(--color-grey);
    margin-bottom: var(--space-4);
  }

  .about-text p:last-child { margin-bottom: 0; }

  /* ── As Featured In ──────────────────────────────────────── */
  .featured-in { background-color: var(--color-charcoal); text-align: center; }
  .featured-in-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: var(--space-4);
  }

  .featured-in-logos {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .featured-in-logos img {
    height: 36px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.65;
    transition: opacity 0.2s;
  }

  .featured-in-logos img:hover { opacity: 1; }

  /* ── Why Work With Me ─────────────────────────────────────── */
  .why-section {
    background-color: #1e3f4a;
  }

  .why-inner {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .why-inner.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .why-heading {
    font-size: clamp(var(--text-2xl), 3vw, var(--text-4xl));
    color: var(--color-white);
    margin-bottom: var(--space-6);
    line-height: var(--leading-tight);
  }

  .why-body {
    margin-bottom: var(--space-8);
  }

  .why-body p {
    font-size: var(--text-base);
    line-height: var(--leading-loose);
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: var(--space-4);
  }

  .why-body p:last-child { margin-bottom: 0; }
  .why-body strong { color: var(--color-white); }

  .lesley-quote {
    margin: var(--space-12) auto 0;
    max-width: 680px;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: var(--space-10);
  }

  .lesley-quote-text {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: clamp(var(--text-xl), 2.2vw, var(--text-2xl));
    color: var(--color-gold);
    line-height: var(--leading-loose);
    margin-bottom: var(--space-5);
  }

  .lesley-quote-credit {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .lesley-name {
    font-weight: var(--font-weight-bold);
    color: var(--color-white);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .lesley-company {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
  }

  /* ── Mailing List ─────────────────────────────────────────── */
  .mailing-section {
    display: grid;
    grid-template-columns: 5fr 6fr;
    min-height: 420px;
    background-color: #a23a2e;
  }

  .mailing-image {
    background-image: url('https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159675705/settings_images/313fd30-b840-7068-1c84-8365c3db73fd_38b5d9d9-f7a2-40de-894e-e5b68af34a47.jpeg');
    background-size: cover;
    background-position: center top;
    min-height: 340px;
  }

  .mailing-panel {
    padding: var(--space-12) var(--space-10);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .mailing-heading {
    font-size: clamp(var(--text-xl), 2.4vw, var(--text-3xl));
    color: var(--color-white);
    margin-bottom: var(--space-3);
    line-height: var(--leading-tight);
  }

  .mailing-body {
    font-size: var(--text-base);
    line-height: var(--leading-loose);
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: var(--space-6);
  }

  .mailing-fields {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .mailing-input {
    flex: 1 1 180px;
    padding: 0.65rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-family: var(--font-body);
    outline: none;
    transition: border-color 0.2s;
  }

  .mailing-input::placeholder { color: rgba(255, 255, 255, 0.55); }
  .mailing-input:focus { border-color: rgba(255, 255, 255, 0.8); }

  .mailing-disclaimer {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 0;
  }

