---
/**
 * /homepage mirrors the root / page.
 * Both canonical to / so Google picks the root URL as authoritative.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TextImage from '../components/TextImage.astro';
import TestimonialRow from '../components/TestimonialRow.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import CTABanner from '../components/CTABanner.astro';
import BlogCard from '../components/BlogCard.astro';

const KAJABI = 'https://members.juliebale.com';

const recentPosts = [
  {
    title: 'The DIVA Framework™: From Self-Doubt to Vocal Confidence & Presence',
    slug: 'divaframework',
    date: '2026-04-16',
    image: 'https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/sites/2147603041/images/7e7c703-1508-f10-252e-b02e5d335ec6_ChroniclesofHopeSeptember2025-209.JPG',
    tags: ['singer'],
  },
  {
    title: 'A Dream That Will Need All the Love You Can Give…',
    slug: 'nobodybetter',
    date: '2025-10-02',
    image: 'https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/blogs/2147505287/images/322c2f3-0ddb-dc2b-1e08-606130b057b_05026df1-de01-4234-8a77-0fd4e6794de9.jpg',
    tags: ['singer'],
  },
  {
    title: 'I Wish I Could Sing',
    slug: 'iwishicouldsing',
    date: '2025-06-15',
    image: 'https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/blogs/2147505287/images/4077f-ca47-73f0-60e2-5e2ea004cc4_13208476-f1b3-4f91-82ba-a52d58f41ecf.JPG',
    tags: ['singer'],
  },
];

const testimonials = [
  {
    quote: 'Julie has truly transformed every day of my future. Now, each morning feels like a song I can sing with confidence. She unlocked something deep within me and lifted my whole world to a new level.',
    name: 'Eve Stanway',
    stars: true,
  },
];
---

<BaseLayout
  title="Julie Bale Voice Specialist | Diva Energy®"
  description="I teach you how to sing and how to use your mind to transform your life using my unique, proven vocal transformation programme From First Note to Final Curtain."
  canonicalURL="https://www.juliebale.com/"
>
  <Hero
    height="large"
    bgImage="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159675705/settings_images/c434b7f-6a4-403c-f222-700e44cf675b_uuid_FA71A6C2-3566-4244-91A4-922AFA7B2EF5_library_1_type_1_mode_1_loc_true_cap_true.jpeg"
    heading="Hi, I'm Julie"
    ctas={[
      { label: 'Work With Me', href: '/workwithme', variant: 'btn--primary' },
      { label: 'From First Note to Final Curtain', href: `${KAJABI}/resource_redirect/landing_pages/2150870945`, variant: 'btn--outline-white' },
    ]}
  >
    <div class="hero-typed-wrapper">
      <p class="hero-typed-lead">I help you <span class="typed-target"></span></p>
    </div>
  </Hero>

  <TextImage
    heading="Want to Know How Singing Can Improve Your Life?"
    image="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159675705/settings_images/cf7f4c5-f02-0da2-5ad8-8cb220724e61_38b5d9d9-f7a2-40de-894e-e5b68af34a47.jpeg"
    imageAlt="Julie Bale teaching a singing workshop"
  >
    <p>
      Many people carry a belief that singing isn't for them — that they're "tone deaf", or that
      they missed their chance. I'm here to tell you that's not true. With the right technique,
      the right mindset, and someone who genuinely believes in you, your voice can transform
      your life in ways you never imagined.
    </p>
    <p>
      Over 35 years of teaching more than 1,000 singers, I've developed a unique approach
      that combines vocal technique, performance coaching, and the power of clinical
      hypnotherapy to help you find the voice — and the confidence — that's already inside you.
    </p>
  </TextImage>

  <section class="featured-in section--sm">
    <div class="container">
      <p class="featured-in-label">As featured in</p>
      <p class="featured-in-outlets">Metro · Woman · Woman's Weekly · Classical Music Magazine · BBC</p>
    </div>
  </section>

  <TestimonialRow heading="What My Singers Say" items={testimonials} columns={1} />

  <FeatureGrid
    heading="All the Ways You Can Work with Me"
    eyebrow="Programmes"
    columns={3}
    items={[
      {
        heading: 'From First Note to Final Curtain',
        body: 'The ultimate vocal transformation programme — 6 or 12 months of 1:1 lessons, performance coaching, and mindset work culminating in a gala concert.',
        href: `${KAJABI}/resource_redirect/landing_pages/2150870945`,
        cta: 'Find Out More',
        ctaVariant: 'btn--primary',
      },
      {
        heading: 'BRAVO for Speakers',
        body: 'A transformational 6-week programme designed to unlock your most powerful, confident, and influential speaking voice. The BRAVO Framework® for speakers and leaders.',
        href: `${KAJABI}/resource_redirect/landing_pages/2151826137`,
        cta: 'Find Out More',
        ctaVariant: 'btn--secondary',
      },
      {
        heading: 'Diva Taster Experience',
        body: 'The 60-minute journey to vocal power and presence. Not ready to commit to the full programme? Start here.',
        href: `${KAJABI}/resource_redirect/landing_pages/2151639319`,
        cta: 'Find Out More',
        ctaVariant: 'btn--outline',
      },
    ]}
    bgColor="#f8f8f6"
  />

  <CTABanner
    heading="Ready to Find Your Voice?"
    body="Join over 1,000 singers and speakers who have transformed their lives with Diva Energy®."
    cta="Work With Me"
    href="/workwithme"
    variant="charcoal"
  />

  <section class="section blog-preview">
    <div class="container">
      <div class="blog-preview-header">
        <h2>From the Blog</h2>
        <a href="/blog" class="btn btn--outline btn--sm">View all posts</a>
      </div>
      <div class="blog-preview-grid">
        {recentPosts.map(post => <BlogCard {...post} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import Typed from 'https://cdn.jsdelivr.net/npm/typed.js@2.1.0/dist/typed.esm.js';
  const el = document.querySelector('.typed-target');
  if (el) {
    new Typed(el as HTMLElement, {
      strings: ['find your voice.', 'step into your Diva Energy®.', 'sing with confidence.', 'transform your performance.', 'believe in yourself.'],
      typeSpeed: 55,
      backSpeed: 30,
      backDelay: 2200,
      loop: true,
    });
  }
</script>

<style>
  .hero-typed-wrapper { margin-bottom: var(--space-4); }
  .hero-typed-lead {
    font-family: var(--font-editorial);
    font-size: var(--text-2xl);
    font-style: italic;
    color: var(--color-white);
    margin-bottom: 0;
  }
  .featured-in { background-color: var(--color-charcoal); text-align: center; }
  .featured-in-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    margin-bottom: var(--space-2);
  }
  .featured-in-outlets {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--color-gold);
    margin-bottom: 0;
  }
  .blog-preview-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-8);
    gap: var(--space-4);
  }
  .blog-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  @media (max-width: 900px) { .blog-preview-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 580px) { .blog-preview-grid { grid-template-columns: 1fr; } }
</style>
