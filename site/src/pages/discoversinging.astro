---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TextImage from '../components/TextImage.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PricingTable from '../components/PricingTable.astro';
import TestimonialRow from '../components/TestimonialRow.astro';
import CTABanner from '../components/CTABanner.astro';
import FormEmbed from '../components/FormEmbed.astro';

const KAJABI = 'https://members.juliebale.com';

const pricingTiers = [
  {
    title: 'From First Note to Final Curtain',
    subtitle: 'The Diva Circle — Full Vocal Transformation Programme',
    price: '£2,995',
    altPrice: 'Or £4,995 for 12 months — monthly payment options available',
    features: [
      'Monthly 1:1 Vocal Lessons with Julie',
      'Online Complete Performer Vocal Technique Course',
      'Performance Mindset & Confidence Training (Hypnotherapy)',
      'Repertoire Planning & Performance Preparation',
      'In-Person Monthly Diva Showcase Performances',
      'Annual Gala Concert, Recording Studio or Stately Home Event',
      'VIP Diva Day option available',
    ],
    cta: 'Book a Discovery Call',
    href: 'https://calendly.com/hypnotherapyforperformance/discover-your-voice-30',
  },
];

const testimonials = [
  {
    quote: 'It is rare in life to find something so profound, yet something you can actually purchase — the experience of being among men and women discovering their own voices. It is an extraordinary moment of abundance.',
    name: 'Evie',
    stars: true,
  },
  {
    quote: 'What happened for me was that you unlocked my voice AND my singing voice, and for me that makes me so, so happy. Having been told that I can\'t sing, even though there\'s part of me that knows that I really can — now I know that I can sing, and that was really special. A massive thank you to you.',
    name: 'Nicola',
    stars: true,
  },
];

const faqs = [
  {
    q: 'Are the programmes suitable for beginners?',
    a: 'They absolutely are! I have written the programmes with all the basics of technique, performance and mindset in place — they are completely suitable for anyone who wants to know more about their voice and bring more singing into their lives.',
  },
  {
    q: 'Do you have to read music to do the programmes?',
    a: 'Not at all. The courses will work at the level you are at. The courses do not teach you any sight reading or music theory — it is a practical learning about your voice and what it can do course. However, you can work with sheet music if you wish in your one to one lessons, though it is not necessary.',
  },
  {
    q: 'Will the programmes help me to sing more confidently?',
    a: 'Absolutely they will. These courses are unique as they add in some exercises in mindset — from my hypnotherapy work. This will help you to feel calm and confident when performing if you practise the exercises alongside the vocal technique.',
  },
  {
    q: 'How much time outside of the programme will I need to invest to see a difference in my singing?',
    a: 'Everyone is different and everyone has different amounts of time available to them. A simple 10 minutes a day practice will make a huge difference to someone who hasn\'t sung regularly before — or for a while. We will figure out the best routine for you as a part of the course, so you get the most out of your investment.',
  },
];
---

<BaseLayout
  title="From First Note to Final Curtain | Vocal Transformation Course | Julie Bale"
  description="A 6/12 month course and one to one session package teaching how to sing, the benefits of singing and how to use your voice, vocal technique, performance technique and mindset using hypnotherapy for singers with renowned opera singer and voice teacher Julie Bale."
>
  <!-- Hero -->
  <Hero
    height="large"
    bgColor="#1e3f4a"
    heading="From First Note to Final Curtain"
    subheading="A vocal transformation programme leading you to become the singer that deep down you know you can be — and step into your Diva Energy®."
    textColor="light"
    eyebrow="Discover Singing"
    ctas={[
      { label: 'Book a Discovery Call', href: 'https://calendly.com/hypnotherapyforperformance/discover-your-voice-30', variant: 'btn--primary' },
      { label: 'Find Out More', href: '#programme', variant: 'btn--outline-white' },
    ]}
  />

  <!-- Programme intro -->
  <div id="programme">
    <TextImage
      heading="Embrace the Diva You Always Knew You Were"
      eyebrow="From First Note to Final Curtain"
      image="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159794714/settings_images/2f652a5-a412-c884-0d51-e1356535ec8_8d8cf78a-520b-4ea4-b571-27954b78b577.PNG"
      imageAlt="Julie Bale vocal transformation programme"
      reverse={false}
      accentLine={true}
      bgColor="#f3e7d3"
    >
      <p>
        <strong>Are you someone who wants to feel completely in your own power?</strong>
      </p>
      <p>
        Maybe you've always wanted to sing but there was no opportunity for you to have lessons.
        Or you feel your voice no longer does what it used to. Or other priorities have taken
        the time you would have liked to spend on your singing.
      </p>
      <p>
        <strong>Or you've been told you can't sing.</strong> You've spent years believing that you
        have to be good at singing to be able to sing. Or worse, someone told you as a child
        that you couldn't — someone who usually didn't have a clue what they were talking about.
      </p>
      <p>
        If that's you, then keep reading. I'd like to introduce you to <em>From First Note to
        Final Curtain</em> — a vocal transformation programme leading you to being the singer that
        deep down you know you can be.
      </p>
    </TextImage>
  </div>

  <!-- What's Included -->
  <FeatureGrid
    heading="Everything You Need to Transform Your Voice"
    eyebrow="What's Included"
    columns={3}
    bgColor="#f3e7d3"
    items={[
      {
        icon: 'fas fa-microphone',
        heading: 'Monthly 1:1 Lessons',
        body: 'At the core of the programme are the monthly one to one sessions — just you and Julie, exploring, discovering, and refining your voice together.',
      },
      {
        icon: 'fas fa-users',
        heading: 'In-Person Monthly Diva Showcase',
        body: 'Meet and work with other fabulous singers on the programme with a professional accompanist. Sing for and support each other in a celebratory setting.',
      },
      {
        icon: 'fas fa-play-circle',
        heading: 'Complete Performer Course',
        body: 'Julie\'s comprehensive online vocal technique course, taking you through HOW to sing, plus her Performance Mindset Course.',
      },
      {
        icon: 'fas fa-brain',
        heading: 'Performance Mindset & Hypnotherapy',
        body: 'Using Julie\'s clinical hypnotherapy expertise to build unshakeable confidence, release performance anxiety, and help you show up fully in your voice.',
      },
      {
        icon: 'fas fa-theater-masks',
        heading: 'Concerts & Events',
        body: 'Regular events — concerts, recordings, exclusive luxury parties — where you celebrate your journey and perform in front of an audience ready to cheer you on.',
      },
      {
        icon: 'fas fa-star',
        heading: 'Repertoire & Performance Prep',
        body: 'Personalised repertoire planning and performance preparation so you\'re always working towards pieces that excite and challenge you.',
      },
    ]}
  />

  <!-- About Julie -->
  <TextImage
    heading="Hi, I'm Julie"
    eyebrow="Your Teacher & Coach"
    image="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159794714/settings_images/5b052f-03f-881-6a25-10145e605312_38b5d9d9-f7a2-40de-894e-e5b68af34a47.jpeg"
    imageAlt="Julie Bale — opera singer, voice teacher and hypnotherapist"
    reverse={true}
    accentLine={true}
  >
    <p>
      An opera singer, voice teacher, choral conductor, and certified clinical hypnotherapist.
      I've taught people at all levels of experience and ability for over 35 years and hold a
      diploma from the Royal College of Music. I've also been a resident voice teacher with
      top London choirs including the London Oriana Choir.
    </p>
    <p>
      It's my mission to help everyone who wants to, to sing with their best voice — and to
      discover how the power of singing can affect their lives in so many ways.
    </p>
    <p>
      I strongly believe that everyone can sing. In my time I have worked with over 1,000 people
      with my unique mixture of vocal technique, performance technique, and performance mindset
      using my skills as a clinical hypnotherapist to give you the confidence to give your best
      performance. I'd love to invite you to join that community.
    </p>
  </TextImage>

  <!-- Why Work With Julie -->
  <section class="section section-why" style="background-color: #c8a24a;">
    <div class="container">
      <div class="why-inner">
        <div class="why-copy">
          <p class="why-eyebrow">Why Work With Me?</p>
          <h2>This isn't just about singing — it's about finding your voice in every sense.</h2>
          <p>
            Your presence, confidence, and communication skills are everything. Working with me
            gives you more than vocal technique; it's a full transformation that helps you show up
            with power, clarity, and authenticity — whether you're speaking on stage, in a meeting,
            or online.
          </p>
          <p>
            You'll join a community of like-minded people who uplift and inspire each other,
            forming a supportive tribe where your growth is celebrated.
          </p>
          <p>
            With over 35 years of experience performing, teaching, leading choirs, and working
            with elite professionals across the UK, I bring a wealth of expertise to guide you.
            I also draw on my skills as a hypnotherapist to help you overcome performance anxiety,
            imposter syndrome, and visibility fears — the things that quietly hold so many of us back.
          </p>
          <p>
            When we work together, you'll gain vocal strength, personal confidence, and the
            presence to truly be seen and heard in your life and beyond.
          </p>
          <a class="btn btn--primary" href="https://calendly.com/hypnotherapyforperformance/discover-your-voice-30">
            I Want to Book
          </a>
        </div>
        <div class="why-image">
          <img
            src="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159794714/settings_images/641286b-c3-018b-6fad-a7b31e27ea0_ChroniclesofHopeSeptember2025-182.jpg"
            alt="Julie Bale performing"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <TestimonialRow
    heading="But Don't Just Take My Word For It..."
    items={testimonials}
    columns={2}
  />

  <!-- Pricing / Booking -->
  <div id="pricing">
    <PricingTable
      heading="The Ultimate Opportunity to Find Your Voice"
      subheading="To apply for a place, please book a discovery call. It's important that we check we can work together and that I can help you before you make this investment."
      tiers={pricingTiers}
      bgColor="#1e3f4a"
    />
  </div>

  <!-- Diva Taster CTA -->
  <CTABanner
    heading="Not Ready for the Full Programme?"
    body="Try The Diva Taster Experience — a focused 60-minute journey to vocal power and presence. The perfect way to discover what's possible."
    cta="The Diva Taster Experience"
    href={`${KAJABI}/resource_redirect/landing_pages/2151639319`}
    variant="gold"
  />

  <!-- FAQ -->
  <section class="section section-faq" style="background-color: #faf7f2;">
    <div class="container faq-container">
      <h2 class="faq-heading">Commonly Asked Questions</h2>
      <div class="faq-list">
        {faqs.map(({ q, a }) => (
          <details class="faq-item">
            <summary class="faq-question">{q}</summary>
            <div class="faq-answer">
              <p>{a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="section--sm section-newsletter">
    <div class="container newsletter-inner">
      <div class="newsletter-copy">
        <h2>Not Ready Yet?</h2>
        <p>Sign up for my newsletter — gentle encouragement, vocal tips, and the occasional story about someone who discovered their voice against all odds.</p>
      </div>
      <FormEmbed
        formId="2148925970"
        landingPageId="2151642696"
        submitLabel="Sign Up"
        disclaimer="I respect your privacy. No spam. Ever."
        bgColor="#f8f8f6"
      />
    </div>
  </section>
</BaseLayout>

<style>
  /* Why work with me */
  .section-why {
    padding-block: var(--space-20);
  }

  .why-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .why-copy {
    background-color: #faf7f2;
    padding: var(--space-10);
    border-radius: var(--radius-md);
  }

  .why-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .why-copy h2 {
    margin-bottom: var(--space-6);
  }

  .why-copy p {
    color: var(--color-grey);
    line-height: var(--leading-loose);
    margin-bottom: var(--space-4);
  }

  .why-copy .btn {
    margin-top: var(--space-4);
  }

  .why-image img {
    width: 100%;
    border-radius: var(--radius-md);
    display: block;
  }

  /* FAQ */
  .faq-container {
    max-width: 800px;
  }

  .faq-heading {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .faq-item {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5) var(--space-6);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .faq-question {
    font-size: var(--text-base);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::after {
    content: '+';
    font-size: var(--text-xl);
    color: var(--color-gold);
    flex-shrink: 0;
  }

  details[open] .faq-question::after {
    content: '−';
  }

  .faq-answer {
    padding-top: var(--space-4);
  }

  .faq-answer p {
    color: var(--color-grey);
    line-height: var(--leading-loose);
    margin-bottom: 0;
  }

  /* Newsletter */
  .section-newsletter { background-color: #f8f8f6; }

  .newsletter-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .newsletter-copy h2 { margin-bottom: var(--space-4); }
  .newsletter-copy p { color: var(--color-grey); line-height: var(--leading-loose); margin-bottom: 0; }

  /* Responsive */
  @media (max-width: 900px) {
    .why-inner {
      grid-template-columns: 1fr;
    }
    .why-image {
      order: -1;
    }
  }

  @media (max-width: 768px) {
    .newsletter-inner { grid-template-columns: 1fr; gap: var(--space-8); }
  }
</style>
