---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import EventCard from '../components/EventCard.astro';
import TextImage from '../components/TextImage.astro';
import CTABanner from '../components/CTABanner.astro';
import FormEmbed from '../components/FormEmbed.astro';

const KAJABI = 'https://members.juliebale.com';

const upcomingEvents = [
  {
    title: 'Divas of Care — Afternoon Concert at Lauderdale House',
    date: '2026-04-26',
    venue: 'Lauderdale House, Highgate',
    location: 'London',
    description: 'Our first Afternoon coffee & cake concert will be held in London in the stunning setting of Lauderdale House, Highgate. Sunday 26th April 2026 at 3.30pm. To join this cohort or to find out more information, click the button.',
    cta: 'Buy Tickets',
    href: 'https://www.lauderdalehouse.org.uk/whats-on/divas-of-care',
    image: 'https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159992207/settings_images/f758bcf-3a24-b25-67bd-fecfb855144b_Home_page_resourcs_photos_773_x_772_px_-9.png',
    imageAlt: 'Divas of Care concert at Lauderdale House',
    tags: ['Live Concert', 'London'],
  },
  {
    title: 'A Summer Soirée — Cliveden House',
    date: '2026-07-13',
    venue: 'Cliveden House',
    location: 'Berkshire',
    description: 'An exclusive invitation-only evening soirée in the breathtaking surroundings of Cliveden House. Places are strictly limited — contact Julie to express your interest.',
    cta: 'Enquire',
    href: 'https://calendly.com/hypnotherapyforperformance/discover-your-voice-30',
    image: 'https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159992207/settings_images/1b13df8-b541-cc48-fde1-5c2dc37511_e54b3176-e9ff-42ee-b9a9-219ff4795a13.jpg',
    imageAlt: 'Cliveden House summer soirée',
    tags: ['Invitation Only', 'Soirée'],
  },
  {
    title: 'Hope Sings Eternal — The Divas Sing for The Chronicles of Hope',
    date: '2026-09-25',
    venue: 'London (Venue TBC)',
    location: 'London',
    description: 'The HOPE Cohort perform to raise funds AND the roof for The Chronicles of Hope Charity. More information coming soon!',
    image: 'https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159992207/settings_images/14f67e-bf7b-7c8e-04a7-42c5e5f18b32_554209dc-7eb0-4c4e-95e8-9c83af302774.png',
    imageAlt: 'Chronicles of Hope charity concert',
    tags: ['Charity Concert', 'London'],
  },
  {
    title: 'The Diva Energy Italy Tour — Lake Garda & Verona',
    date: '2027-08-01',
    venue: 'Lake Garda & Verona',
    location: 'Italy',
    description: 'Only 10 singers will be invited to join our Diva tour singing in Lake Garda & Verona — with some special surprises. Book a call below to find out how you can be a part of this unique experience.',
    cta: 'Book A Call',
    href: 'https://calendly.com/hypnotherapyforperformance/discover-your-voice-30',
    image: 'https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159992207/settings_images/0cdf353-45c-0e6b-786d-044ea0d77a_e6db8599-1a7d-4219-be39-b9dfa633ddc6.jpeg',
    imageAlt: 'Diva Energy Italy Tour - Lake Garda and Verona',
    tags: ['Tour', 'Italy'],
  },
];
---

<BaseLayout
  title="Diva Energy Live Events | Julie Bale"
  description="Live events, workshops, gala showcases, and masterclasses with Julie Bale — voice specialist and founder of Diva Energy®."
>
  <Hero
    height="large"
    bgImage="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2163398396/settings_images/45e6fe0-ae8-babf-dd23-40f0860d551_ed182231-602c-4d11-8722-12777372ac30.jpeg"
    heading="Diva Energy Live"
    subheading="Workshops, masterclasses, and gala showcases that bring the Diva Energy® method to life."
    textColor="light"
    eyebrow="Live Events"
    ctas={[
      { label: 'See Upcoming Events', href: '#events', variant: 'btn--primary' },
    ]}
  />

  <!-- Intro -->
  <TextImage
    heading="Experiences That Transform"
    eyebrow="More Than a Workshop"
    image="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2163398396/settings_images/c8876ad-5cb0-2a6-21f-8162cebd5bce_193a8d70-aa8b-47c1-876f-bc2c96d61ed3.png"
    imageAlt="Julie Bale live event"
    reverse={false}
    accentLine={true}
  >
    <p>
      Diva Energy Live events are where the transformation happens in real time — in front of
      a room full of people who are all there to witness the same thing: the moment a person
      discovers what their voice can truly do.
    </p>
    <p>
      Whether it's a gala showcase where my students perform live for the first time, or a
      full-day BRAVO intensive for corporate speakers, every event is designed to create an
      experience you won't forget.
    </p>
    <p>
      Check below for upcoming events — and if you'd like to be the first to know about new
      dates, sign up to my newsletter.
    </p>
  </TextImage>

  <!-- Events listing -->
  <section id="events" class="section section-events">
    <div class="container">
      <div class="events-header">
        <p class="events-eyebrow">Upcoming Events</p>
        <h2>What's On</h2>
      </div>

      {upcomingEvents.length > 0 ? (
        <div class="events-list">
          {upcomingEvents.map(event => <EventCard {...event} />)}
        </div>
      ) : (
        <div class="events-empty">
          <p>No events are currently scheduled. Sign up below to be the first to know when new dates are announced.</p>
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <CTABanner
    heading="Want to Perform Live?"
    body="The From First Note to Final Curtain programme culminates in a real gala concert. Take the first step."
    cta="Explore the Programme"
    href={`${KAJABI}/resource_redirect/landing_pages/2150870945`}
    variant="gold"
  />

  <!-- Newsletter -->
  <section class="section--sm section-newsletter">
    <div class="container newsletter-inner">
      <div class="newsletter-copy">
        <h2>Be First to Hear About New Events</h2>
        <p>Sign up to my newsletter and I'll let you know as soon as new dates are announced.</p>
      </div>
      <FormEmbed
        formId="2148925970"
        landingPageId="2151642696"
        submitLabel="Sign Up"
        disclaimer="I respect your privacy. No spam. Ever."
        bgColor="#f8f8f6"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .section-events { background-color: var(--color-white); }

  .events-header {
    margin-bottom: var(--space-10);
  }

  .events-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .events-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 860px;
  }

  .events-empty {
    background-color: #f8f8f6;
    border-radius: var(--radius-md);
    padding: var(--space-12);
    text-align: center;
    color: var(--color-grey);
  }

  .section-newsletter { background-color: #f8f8f6; }

  .newsletter-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .newsletter-copy h2 { margin-bottom: var(--space-4); }
  .newsletter-copy p { color: var(--color-grey); line-height: var(--leading-loose); margin-bottom: 0; }

  @media (max-width: 768px) {
    .newsletter-inner { grid-template-columns: 1fr; gap: var(--space-8); }
  }
</style>
