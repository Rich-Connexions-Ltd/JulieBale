---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TextImage from '../components/TextImage.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import PricingTable from '../components/PricingTable.astro';
import TestimonialRow from '../components/TestimonialRow.astro';
import CTABanner from '../components/CTABanner.astro';
import FormEmbed from '../components/FormEmbed.astro';

const KAJABI = 'https://members.juliebale.com';
const CALENDLY = 'https://calendly.com/hypnotherapyforperformance/discover-your-voice-30';

const bravoPillars = [
  {
    letter: 'B',
    title: 'Belief',
    desc: 'Build unshakeable internal certainty so your voice carries conviction.',
  },
  {
    letter: 'R',
    title: 'Resonance',
    desc: 'Unlock the natural depth, warmth, and richness in your voice.',
  },
  {
    letter: 'A',
    title: 'Authority',
    desc: 'Develop vocal and physical presence that establishes instant credibility.',
  },
  {
    letter: 'V',
    title: 'Vocal Presence',
    desc: 'Learn to use breath, pacing, tone, and silence to captivate attention.',
  },
  {
    letter: 'O',
    title: 'Ownership',
    desc: 'Step fully into your identity as a confident, compelling speaker.',
  },
];

const pricingTiers = [
  {
    title: 'BRAVO Day',
    subtitle: 'Group Programme',
    price: '£197',
    features: [
      'Live in-person group day (Watford)',
      'The BRAVO Framework® vocal training',
      'Nervous system regulation tools',
      'Performance confidence coaching',
      'Practise your keynote with live expert feedback',
      'Limited to 10 people for personalised coaching',
      'Next BRAVO Day: 4th October',
    ],
    cta: 'Book a Call',
    href: CALENDLY,
  },
  {
    title: 'VIP 1:1 Day',
    subtitle: 'Intensive Private Coaching',
    price: '£997',
    features: [
      'Full-day private intensive with Julie (Watford)',
      'Core vocal techniques and mindset work',
      'Live expert vocal coaching on your talk',
      'Immediate, tangible transformation',
      'Foundation for ongoing BRAVO Days',
      'Dates available June, July & September',
      'Priority: can start with VIP Day or BRAVO Day',
    ],
    cta: 'Book a Call',
    href: CALENDLY,
    highlight: true,
    highlightLabel: 'Most Transformational',
  },
];

const testimonials = [
  {
    quote: 'It is rare in life to find something so profound, yet something you can actually purchase — the experience of being among men and women discovering their own voices. It is an extraordinary moment of abundance.',
    name: 'Evie',
    role: 'BRAVO Programme',
    stars: true,
  },
  {
    quote: 'What happened for me was that you unlocked my voice AND my singing voice, and for me that makes me so, so happy. Having been told that I can\'t sing, now I know that I can sing — and that was really special.',
    name: 'Nicola',
    role: 'BRAVO Programme',
    stars: true,
  },
];
---

<BaseLayout
  title="BRAVO for Speakers — Voice & Mindset Mastery | Julie Bale"
  description="A transformational 6-week voice and mindset programme for speakers and leaders. The BRAVO Framework® integrates voice science, performance psychology, and nervous system mastery."
>
  <Hero
    height="large"
    bgColor="#0b1c2d"
    heading="BRAVO for Speakers"
    subheading="Become the speaker your message deserves."
    textColor="light"
    eyebrow="The BRAVO Framework®"
    ctas={[
      { label: 'How Do I Book?', href: CALENDLY, variant: 'btn--primary' },
      { label: 'Book a VIP Day', href: CALENDLY, variant: 'btn--outline-white' },
    ]}
  />

  <!-- Why Voice Changes Everything -->
  <TextImage
    heading="Why Voice Changes Everything"
    eyebrow="You Know Your Message Matters"
    image="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159794714/settings_images/d4f32e7-7e77-4247-625-4cf327c2fd43_126938a2-15b8-44a3-bf8b-bab9821b028e.png"
    imageAlt="Voice changes everything — Julie Bale BRAVO for Speakers"
    reverse={false}
    accentLine={true}
    bgColor="#c9a24d"
  >
    <p>
      You see the impact your message could have. The clients it could attract. The doors it could open.
    </p>
    <p>
      But when it's time to speak — on stage, on video, or in a room full of opportunity — your voice
      doesn't always reflect the authority, confidence, and conviction you feel inside.
    </p>
    <p>This is not a message problem. This is a voice, nervous system, and identity problem. And it is entirely trainable.</p>
    <p>People decide whether to trust you in seconds. Not just based on your words, but on your tone, your presence, and your certainty. When your voice aligns with your message:</p>
    <ul>
      <li>People listen more closely</li>
      <li>They trust you more deeply</li>
      <li>They remember you longer</li>
      <li>And they act more readily</li>
    </ul>
    <p>Your voice becomes your greatest asset in business and leadership.</p>
    <h3>Who This Is For</h3>
    <p>This programme is for founders, entrepreneurs, coaches, consultants, leaders, executives, and aspiring and experienced speakers who want their voice to match the power of their message.</p>
  </TextImage>

  <!-- What is BRAVO -->
  <TextImage
    heading="The BRAVO Framework®"
    eyebrow="Voice Science Meets Performance Psychology"
    image="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2163398396/settings_images/cd6852d-536c-3680-b7f8-777517faa8e_554209dc-7eb0-4c4e-95e8-9c83af302774.png"
    imageAlt="BRAVO for Speakers programme"
    reverse={true}
    accentLine={true}
    bgColor="#c9a24d"
  >
    <p>
      BRAVO for Speakers is a transformational voice and mindset mastery programme designed for
      speakers, leaders, coaches, and anyone who uses their voice professionally.
    </p>
    <p>
      Through expert vocal training, performance coaching, and mindset work, you will develop a voice that
      commands attention, creates trust instantly, conveys authority effortlessly, and moves people to act.
    </p>
    <p>
      This is the work that changes how people perceive you — and how you perceive yourself.
    </p>
  </TextImage>

  <!-- BRAVO Pillars -->
  <section class="section section-pillars" style="background-color: var(--color-charcoal);">
    <div class="container">
      <div class="pillars-header">
        <p class="pillars-eyebrow">The Framework</p>
        <h2 class="pillars-heading">Introducing The BRAVO Framework® for Speakers</h2>
        <p class="pillars-intro">A proven framework integrating voice science, performance psychology, and nervous system mastery.</p>
      </div>
      <div class="pillars-grid">
        {bravoPillars.map(({ letter, title, desc }) => (
          <div class="pillar-card">
            <span class="pillar-letter">{letter}</span>
            <h3 class="pillar-title">{title}</h3>
            <p class="pillar-desc">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Audio preview -->
  <section class="section--sm section-audio">
    <div class="container audio-inner">
      <div class="audio-copy">
        <p class="audio-eyebrow">Hear From Julie</p>
        <h2>A Message About BRAVO</h2>
        <p>Listen to Julie explain the BRAVO Framework® and what you can expect from the programme.</p>
      </div>
      <div class="audio-player-col">
        <AudioPlayer id="hsz5tw7re2" title="BRAVO for Speakers — message from Julie" />
      </div>
    </div>
  </section>

  <!-- Programme Experience: Phase 1 + Phase 2 -->
  <section class="section section-programme" style="background-color: #f8f8f6;">
    <div class="container">
      <div class="programme-header">
        <p class="programme-eyebrow">The Programme Experience</p>
        <h2>How It Works</h2>
      </div>
      <div class="programme-phases">

        <div class="phase-card">
          <div class="phase-label">Phase 1</div>
          <h3 class="phase-title">VIP 1:1 In-Person Intensive Day — Watford</h3>
          <p class="phase-intro">You'll begin with a powerful live immersion where you will:</p>
          <ul class="phase-list">
            <li>Learn core vocal techniques</li>
            <li>Understand how your mindset affects your voice</li>
            <li>Rehearse your talk and receive live expert vocal coaching</li>
            <li>Experience immediate, tangible transformation</li>
          </ul>
          <p>This day establishes the foundation for everything that follows.</p>
        </div>

        <div class="phase-card">
          <div class="phase-label">Phase 2</div>
          <h3 class="phase-title">Join the BRAVO Speaker Days</h3>
          <p class="phase-intro">Bi-monthly live sessions where you will practise:</p>
          <ul class="phase-list">
            <li>Calming your nervous system and accessing vocal stability</li>
            <li>Improving vocal strength, resonance, and range</li>
            <li>Improving clarity, articulation, and authority</li>
            <li>Building confidence through performance coaching</li>
            <li>Elevating your keynotes</li>
          </ul>
          <p>You will deliver your keynote with confidence, authority, emotional connection, and vocal mastery. You will experience yourself as a powerful, confident speaker.</p>
        </div>

      </div>

      <div class="programme-outcomes">
        <h3>What You Leave With</h3>
        <p>A permanent shift in how you speak, show up, and lead. You will leave with:</p>
        <ul class="outcomes-list">
          <li>Fully performance-ready keynotes</li>
          <li>A confident, reliable, and powerful voice</li>
          <li>Tools to regulate nerves before any speaking opportunity</li>
          <li>Greater authority and executive presence</li>
          <li>Skills that serve you for life</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <TestimonialRow
    heading="What Speakers Say About BRAVO"
    items={testimonials}
    columns={2}
  />

  <!-- Bio: Hi I'm Julie -->
  <TextImage
    heading="Hi, I'm Julie..."
    eyebrow="Why Work With Me"
    image="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159794714/settings_images/5b052f-03f-881-6a25-10145e605312_38b5d9d9-f7a2-40de-894e-e5b68af34a47.jpeg"
    imageAlt="Julie Bale — opera singer, voice teacher and clinical hypnotherapist"
    reverse={true}
    accentLine={true}
  >
    <p>
      An opera singer, voice teacher, choral conductor, keynote speaker, and certified clinical hypnotherapist.
    </p>
    <p>
      I've taught people at all levels of experience and ability for over 35 years and have a diploma from the
      Royal College of Music. I've also been a resident voice teacher with top London choirs such as the
      London Oriana Choir.
    </p>
    <p>
      It's my mission to help everyone who wants to learn how the power of their voice can affect their lives
      in so many ways. I have worked with over 1,000 people using my unique mixture of vocal technique
      (how the body works), performance technique (how you connect to the audience), and performance
      mindset (using my skills as a clinical hypnotherapist) — giving you the confidence and belief to give
      your best performance.
    </p>
    <p>
      I realise that the same techniques I use with my singers are equally powerful for speakers. That's why
      I created the BRAVO Framework®.
    </p>
  </TextImage>

  <!-- Pricing -->
  <PricingTable
    heading="Choose Your BRAVO Journey"
    subheading="Whether you join the group programme or want an intensive VIP day, both options deliver the same BRAVO transformation."
    tiers={pricingTiers}
    bgColor="#f8f8f6"
  />

  <!-- Book a Call -->
  <section class="section section-book" id="book-a-call">
    <div class="container book-inner">
      <div class="book-copy">
        <p class="book-eyebrow">Apply for a Place</p>
        <h2>Ready to Become the Speaker Your Message Deserves?</h2>
        <p>
          To apply for a place please book a call with me. It's important to check that we feel
          we can work together and that I can help you before making this investment.
        </p>
        <p class="book-details">
          <strong>VIP Days:</strong> Booking for June, July &amp; September — Watford<br/>
          <strong>BRAVO Day:</strong> 4th October — Watford (limited to 10 people)
        </p>
        <a href={CALENDLY} class="btn btn--primary book-cta" target="_blank" rel="noopener">
          Book a Call
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABanner
    heading="Ready to Find Your Speaking Voice?"
    body="Join speakers and leaders who have transformed how they show up with BRAVO."
    cta="Book a Call"
    href={CALENDLY}
    variant="charcoal"
  />

  <!-- Newsletter -->
  <section class="section--sm section-newsletter">
    <div class="container newsletter-inner">
      <div class="newsletter-copy">
        <h2>Not Quite Ready Yet?</h2>
        <p>Sign up for my weekly newsletter and I'll send you vocal tips, mindset coaching, and inspiration — free.</p>
      </div>
      <FormEmbed
        formId="2148925970"
        landingPageId="2151642696"
        submitLabel="Sign Up"
        disclaimer="I respect your privacy. No spam. Ever."
        bgColor="#f8f8f6"
      />
    </div>
  </section>
</BaseLayout>

<style>
  /* ----------------------------------------
     Audio section
  ---------------------------------------- */
  .section-audio { background-color: var(--color-white); }

  .audio-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .audio-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .audio-copy h2 { margin-bottom: var(--space-4); }
  .audio-copy p { color: var(--color-grey); line-height: var(--leading-loose); margin-bottom: 0; }

  /* ----------------------------------------
     BRAVO Pillars section
  ---------------------------------------- */
  .section-pillars { color: var(--color-white); }

  .pillars-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .pillars-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .pillars-heading {
    color: var(--color-white);
    margin-bottom: var(--space-4);
  }

  .pillars-intro {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: var(--text-xl);
    color: rgba(255,255,255,0.75);
    margin-bottom: 0;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-5);
  }

  .pillar-card {
    background-color: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    text-align: center;
  }

  .pillar-letter {
    display: block;
    font-size: var(--text-4xl);
    font-family: var(--font-editorial);
    font-weight: var(--font-weight-bold);
    color: var(--color-gold);
    line-height: 1;
    margin-bottom: var(--space-3);
  }

  .pillar-title {
    font-size: var(--text-base);
    color: var(--color-white);
    margin-bottom: var(--space-2);
  }

  .pillar-desc {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.65);
    line-height: var(--leading-loose);
    margin-bottom: 0;
  }

  /* ----------------------------------------
     Programme phases section
  ---------------------------------------- */
  .programme-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .programme-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-teal-muted);
    margin-bottom: var(--space-3);
  }

  .programme-header h2 { margin-bottom: 0; }

  .programme-phases {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .phase-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-8);
  }

  .phase-label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-white);
    background-color: var(--color-gold);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-3);
    margin-bottom: var(--space-4);
  }

  .phase-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }

  .phase-intro {
    color: var(--color-grey);
    margin-bottom: var(--space-3);
  }

  .phase-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4) 0;
  }

  .phase-list li {
    padding: var(--space-1) 0 var(--space-1) var(--space-5);
    color: var(--color-grey);
    font-size: var(--text-sm);
    line-height: var(--leading-loose);
    position: relative;
  }

  .phase-list li::before {
    content: '•';
    position: absolute;
    left: var(--space-2);
    color: var(--color-gold);
  }

  .phase-card p:last-child { margin-bottom: 0; color: var(--color-charcoal); }

  .programme-outcomes {
    background-color: var(--color-charcoal);
    color: var(--color-white);
    border-radius: var(--radius-md);
    padding: var(--space-10);
    text-align: center;
  }

  .programme-outcomes h3 {
    color: var(--color-white);
    margin-bottom: var(--space-4);
  }

  .programme-outcomes > p {
    color: rgba(255,255,255,0.8);
    margin-bottom: var(--space-6);
  }

  .outcomes-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) var(--space-8);
  }

  .outcomes-list li {
    color: rgba(255,255,255,0.85);
    font-size: var(--text-sm);
    padding-left: var(--space-5);
    position: relative;
  }

  .outcomes-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-gold);
    font-weight: bold;
  }

  /* ----------------------------------------
     Book a Call section
  ---------------------------------------- */
  .section-book {
    background-color: var(--color-white);
    border-top: 4px solid var(--color-gold);
  }

  .book-inner {
    max-width: 680px;
    text-align: center;
  }

  .book-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .book-inner h2 { margin-bottom: var(--space-6); }
  .book-inner p { color: var(--color-grey); line-height: var(--leading-loose); margin-bottom: var(--space-4); }

  .book-details {
    background-color: #f8f8f6;
    border-radius: var(--radius-md);
    padding: var(--space-5) var(--space-6);
    font-size: var(--text-sm);
    margin-bottom: var(--space-6) !important;
  }

  .book-details strong { color: var(--color-charcoal); }

  .book-cta {
    display: inline-block;
  }

  /* ----------------------------------------
     Newsletter section
  ---------------------------------------- */
  .section-newsletter { background-color: #f8f8f6; }

  .newsletter-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .newsletter-copy h2 { margin-bottom: var(--space-4); }
  .newsletter-copy p { color: var(--color-grey); line-height: var(--leading-loose); margin-bottom: 0; }

  /* ----------------------------------------
     Responsive
  ---------------------------------------- */
  @media (max-width: 1100px) {
    .pillars-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 900px) {
    .pillars-grid { grid-template-columns: repeat(3, 1fr); }
    .programme-phases { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .audio-inner,
    .newsletter-inner { grid-template-columns: 1fr; gap: var(--space-8); }
    .pillars-grid { grid-template-columns: repeat(2, 1fr); }
    .outcomes-list { flex-direction: column; align-items: flex-start; padding: 0 var(--space-4); }
    .book-inner { text-align: left; }
  }

  @media (max-width: 480px) {
    .pillars-grid { grid-template-columns: 1fr; }
  }
</style>
