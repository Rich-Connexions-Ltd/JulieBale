---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TextImage from '../components/TextImage.astro';
import CTABanner from '../components/CTABanner.astro';
import FormEmbed from '../components/FormEmbed.astro';
---

<BaseLayout
  title="The Real Me Isn't Fat — Julie Bale's Book"
  description="The Real Me Isn't Fat by Julie Bale — a deeply personal book about identity, self-worth, and the relationship between how we feel about our bodies and how we show up in the world."
>
  <Hero
    height="banner"
    bgColor="var(--color-charcoal)"
    heading="The Real Me Isn't Fat"
    subheading="A book about identity, self-worth, and finding the real you."
    textColor="light"
    eyebrow="Julie's Book"
    ctas={[
      { label: 'Buy on Amazon', href: 'https://amzn.eu/d/0U9bgi5', variant: 'btn--primary', target: '_blank' },
    ]}
  />

  <!-- About the book -->
  <TextImage
    heading="A Book Born from Personal Experience"
    eyebrow="About the Book"
    image="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159675705/settings_images/cf7f4c5-f02-0da2-5ad8-8cb220724e61_38b5d9d9-f7a2-40de-894e-e5b68af34a47.jpeg"
    imageAlt="The Real Me Isn't Fat — Julie Bale"
    reverse={false}
    accentLine={true}
  >
    <p>
      <em>The Real Me Isn't Fat</em> is Julie Bale's deeply personal account of using weight
      and food as a way of hiding — and the journey to discovering who she really was underneath.
    </p>
    <p>
      Drawing on her experiences as a clinical hypnotherapist and her own story of transformation,
      Julie explores the hidden relationship between body image, identity, and self-worth —
      and offers a compassionate, practical path towards genuine change.
    </p>
    <p>
      This is not a diet book. It's a book about <em>you</em> — and what becomes possible when
      you stop believing the stories you've been told about your body.
    </p>
    <p>Featured in <strong>Metro</strong>, <strong>Woman</strong>, and <strong>Woman's Weekly</strong>.</p>
  </TextImage>

  <!-- What readers say -->
  <section class="section section-reviews" style="background-color: #f8f8f6;">
    <div class="container">
      <h2 class="reviews-heading">What Readers Say</h2>
      <div class="reviews-grid">
        {[
          {
            quote: 'This book changed how I see myself. Julie writes with such honesty and compassion — I felt seen on every page.',
            name: 'Amazon Reviewer',
          },
          {
            quote: 'Not preachy, not a diet plan — just a beautiful, honest exploration of what it means to be at war with your body, and how to find peace.',
            name: 'Amazon Reviewer',
          },
          {
            quote: 'I\'ve read dozens of books on this topic. This is the first one that got to the heart of why I eat the way I do.',
            name: 'Amazon Reviewer',
          },
        ].map(({ quote, name }) => (
          <blockquote class="review-item">
            <p class="review-quote">"{quote}"</p>
            <footer class="review-name">— {name}</footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- Buy section -->
  <section class="section section-buy">
    <div class="container buy-inner">
      <div class="buy-copy">
        <p class="buy-eyebrow">Get the Book</p>
        <h2>Available on Amazon</h2>
        <p>
          <em>The Real Me Isn't Fat</em> is available in paperback and Kindle formats on Amazon.
          Click below to order your copy.
        </p>
        <div class="buy-buttons">
          <a href="https://amzn.eu/d/0U9bgi5" class="btn btn--lg btn--primary" target="_blank" rel="noopener noreferrer">
            <i class="fas fa-book" aria-hidden="true"></i> Buy Paperback
          </a>
          <a href="https://amzn.eu/d/8KKf3J9" class="btn btn--lg btn--outline" target="_blank" rel="noopener noreferrer">
            <i class="fas fa-tablet-alt" aria-hidden="true"></i> Buy Kindle
          </a>
        </div>
      </div>
      <div class="buy-media">
        <p class="media-label">As featured in</p>
        <p class="media-outlets">Metro · Woman · Woman's Weekly · BBC</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABanner
    heading="Want to Go Deeper?"
    body="Explore Julie's hypnotherapy approach to weight management and body image."
    cta="Learn More"
    href="/weightmanagement"
    variant="teal"
  />

  <!-- Newsletter -->
  <section class="section--sm section-newsletter">
    <div class="container newsletter-inner">
      <div class="newsletter-copy">
        <h2>Stay in the Diva World</h2>
        <p>Sign up for my weekly newsletter — mindset coaching, vocal tips, and inspiration.</p>
      </div>
      <FormEmbed
        formId="2148925970"
        landingPageId="2151642696"
        submitLabel="Sign Up"
        disclaimer="I respect your privacy. No spam. Ever."
        bgColor="#f8f8f6"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .reviews-heading {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .review-item {
    background-color: var(--color-white);
    border-left: 3px solid var(--color-gold);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: var(--space-6);
  }

  .review-quote {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: var(--text-base);
    color: var(--color-charcoal);
    line-height: var(--leading-loose);
    margin-bottom: var(--space-4);
  }

  .review-name {
    font-size: var(--text-sm);
    color: var(--color-teal-muted);
  }

  .section-buy { background-color: var(--color-white); }

  .buy-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .buy-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .buy-copy h2 { margin-bottom: var(--space-4); }
  .buy-copy p { color: var(--color-grey); line-height: var(--leading-loose); margin-bottom: var(--space-8); }

  .buy-buttons {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    align-items: center;
  }

  .buy-buttons .fa-book,
  .buy-buttons .fa-tablet-alt {
    margin-right: var(--space-2);
  }

  .buy-media {
    text-align: center;
  }

  .media-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-teal-muted);
    margin-bottom: var(--space-2);
  }

  .media-outlets {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--color-charcoal);
    margin-bottom: 0;
  }

  .section-newsletter { background-color: #f8f8f6; }

  .newsletter-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .newsletter-copy h2 { margin-bottom: var(--space-4); }
  .newsletter-copy p { color: var(--color-grey); line-height: var(--leading-loose); margin-bottom: 0; }

  @media (max-width: 900px) {
    .reviews-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .buy-inner,
    .newsletter-inner { grid-template-columns: 1fr; gap: var(--space-8); }
    .buy-buttons { flex-direction: column; align-items: flex-start; }
  }
</style>
