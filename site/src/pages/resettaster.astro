---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TextImage from '../components/TextImage.astro';
import CTABanner from '../components/CTABanner.astro';
import FormEmbed from '../components/FormEmbed.astro';
---

<BaseLayout
  title="Weight Reset Taster Session | Julie Bale"
  description="Book a Weight Reset Taster session with Julie Bale — a focused 60-minute hypnotherapy session to begin transforming your relationship with food and your body."
  noIndex={true}
>
  <Hero
    height="medium"
    bgColor="var(--color-charcoal)"
    heading="Weight Reset Taster Session"
    subheading="A focused 60-minute hypnotherapy session to begin your weight reset journey."
    textColor="light"
    eyebrow="First Step"
    ctas={[
      { label: 'Book Your Taster', href: '/contact', variant: 'btn--primary' },
    ]}
  />

  <TextImage
    heading="Your First Step Towards a Different Relationship with Your Body"
    eyebrow="The Taster Session"
    image="https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2159675705/settings_images/cf7f4c5-f02-0da2-5ad8-8cb220724e61_38b5d9d9-f7a2-40de-894e-e5b68af34a47.jpeg"
    imageAlt="Julie Bale — clinical hypnotherapist"
    reverse={false}
    accentLine={true}
  >
    <p>
      The Weight Reset Taster is a 60-minute 1:1 session with Julie, designed to give you a
      genuine taste of how clinical hypnotherapy can begin to shift your relationship with
      food and your body.
    </p>
    <p>
      In one session you'll explore the emotional patterns behind your eating habits, experience
      a guided hypnotherapy induction, and leave with clarity about what a full Weight Reset
      programme would look like for you.
    </p>
    <p>
      This is a real working session, not a sales call. You'll leave with something tangible —
      and a clear picture of your next step.
    </p>
    <a href="/contact" class="btn btn--md btn--primary">Book Your Taster</a>
  </TextImage>

  <!-- Newsletter -->
  <section class="section--sm section-newsletter" style="background-color: #f8f8f6;">
    <div class="container newsletter-inner">
      <div class="newsletter-copy">
        <h2>Learn More About Hypnotherapy</h2>
        <p>Sign up for my newsletter to receive regular insights into hypnotherapy, mindset, and wellbeing.</p>
      </div>
      <FormEmbed
        formId="2148925970"
        landingPageId="2151642696"
        submitLabel="Sign Up"
        disclaimer="I respect your privacy. No spam. Ever."
        bgColor="#f8f8f6"
      />
    </div>
  </section>

  <CTABanner
    heading="Want to Go Deeper?"
    body="Explore the full Weight Management Hypnotherapy approach."
    cta="Find Out More"
    href="/weightmanagement"
    variant="teal"
  />
</BaseLayout>

<style>
  .newsletter-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .newsletter-copy h2 { margin-bottom: var(--space-4); }
  .newsletter-copy p { color: var(--color-grey); line-height: var(--leading-loose); margin-bottom: 0; }

  @media (max-width: 768px) {
    .newsletter-inner { grid-template-columns: 1fr; gap: var(--space-8); }
  }
</style>
